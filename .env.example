# Copy this file to `.env` and fill in what the studio has confirmed.
# NEVER put secrets in VITE_* variables — everything prefixed VITE_
# is embedded in the public JavaScript bundle.

# Enquiry endpoint (Formspree / Getform / custom API) that accepts a JSON
# POST { name, phone, email, type, location, area, budget, stage, message,
# source, page }. Leave empty and the form hands off to the visitor's
# email app instead (honest handoff state, never a fake success).
VITE_ENQUIRY_ENDPOINT=

# Production domain, no trailing slash. Used for canonical URLs, og:url,
# og:image and sitemap.xml at build time. Leave empty in development.
VITE_SITE_URL=
